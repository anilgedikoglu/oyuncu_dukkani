<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Liderlik tablosu (GameKit). App ID'de Game Center capability ACIK
	     olmali, yoksa provisioning profile bu entitlement'i icermez ve
	     imzalama "profile doesn't match entitlements" ile patlar. -->
	<key>com.apple.developer.game-center</key>
	<true/>
</dict>
</plist>
